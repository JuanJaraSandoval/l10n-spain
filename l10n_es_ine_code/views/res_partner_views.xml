<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_view_form_ine" model="ir.ui.view">
        <field name="name">res.partner.form.ine.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]" position="inside">
                <div class="o_address_ine_code">
                    <field
                        name="ine_code"
                        readonly="1"
                        placeholder="Auto-filled from city"
                        invisible="not ine_code"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
