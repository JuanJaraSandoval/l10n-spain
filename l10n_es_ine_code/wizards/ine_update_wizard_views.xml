<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_ine_update_wizard_form" model="ir.ui.view">
        <field name="name">ine.update.wizard.form</field>
        <field name="model">ine.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update INE municipality codes">
                <sheet>
                    <group>
                        <group string="Options">
                            <field name="overwrite" />
                            <field name="dry_run" />
                        </group>
                    </group>

                    <group string="Information">
                        <div class="alert alert-info" role="alert">
                            This wizard updates INE municipality codes using the
                            CSV files shipped with the module.
                            Use <strong>Simulate</strong> first to review the result
                            before applying changes.
                        </div>
                    </group>

                    <group string="Summary">
                        <field name="result" nolabel="1" readonly="1" widget="text" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_simulate"
                        string="Simulate"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="btn-secondary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ine_update_wizard" model="ir.actions.act_window">
        <field name="name">Update INE municipality codes</field>
        <field name="res_model">ine.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ine_update_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
